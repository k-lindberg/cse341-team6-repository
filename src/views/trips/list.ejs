<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters">
    Search by Region:
    <select id="region-filter">
        <option value="all">All Regions</option>
        <% regions.forEach((region) => { %>
            <option value="<%= region %>"><%= region.charAt(0).toUpperCase() + region.slice(1) %></option>
        <% }); %>
    </select>

    Search by Season:
    <select id="season-filter">
        <option value="all">Any Season</option>
        <% seasons.forEach((season) => { %>
            <option value="<%= season %>"><%= season.charAt(0).toUpperCase() + season.slice(1) %></option>
        <% }); %>
    </select>
</div>

<!-- The container is now empty. JS will populate it. -->
<div class="routes-grid" id="trips-container">
    <p>Loading trips...</p>
</div>

<script>
    document.addEventListener("DOMContentLoaded", async () => {
        const container = document.getElementById("trips-container");
        const regionFilter = document.getElementById("region-filter");
        const seasonFilter = document.getElementById("season-filter");
        
        let allTrips = [];

        // Helper to create an element with text content safely
        const el = (tag, className, text) => {
            const node = document.createElement(tag);
            if (className) node.className = className;
            if (text !== undefined && text !== null) node.textContent = text;
            return node;
        };

        try {
            const response = await fetch("/api/trips");
            if (!response.ok) throw new Error("Failed to fetch trips");
            allTrips = await response.json();

            const renderTrips = () => {
                const regionValue = regionFilter.value;
                const seasonValue = seasonFilter.value;

                const filteredTrips = allTrips.filter(trip => {
                    const matchRegion = regionValue === "all" || trip.region === regionValue;
                    const matchSeason = seasonValue === "all" || trip.bestSeason === seasonValue;
                    return matchRegion && matchSeason;
                });

                // Clear the container safely
                container.replaceChildren();

                if (filteredTrips.length === 0) {
                    container.appendChild(el("p", null, "No trips match your filters."));
                    return;
                }

                filteredTrips.forEach(trip => {
                    // Card
                    const card = el("div", `route-card ${trip.region || ""}`);

                    // Header
                    const header = el("div", "route-header");
                    header.appendChild(el("h2", "route-name", trip.name));
                    header.appendChild(el("span", "route-region", trip.region));
                    card.appendChild(header);

                    // Station info
                    const stationInfo = el("div", "station-info");
                    
                    const startStation = el("div", "station");
                    startStation.appendChild(el("div", "station-type", "From:"));
                    startStation.appendChild(el("div", "station-name", trip.startStation));
                    
                    const arrow = el("div", "route-arrow", "\u2192"); // →
                    
                    const endStation = el("div", "station");
                    endStation.appendChild(el("div", "station-type", "To:"));
                    endStation.appendChild(el("div", "station-name", trip.endStation));
                    
                    stationInfo.append(startStation, arrow, endStation);
                    card.appendChild(stationInfo);

                    // Details
                    const details = el("div", "route-details");

                    const durationItem = el("div", "detail-item");
                    durationItem.appendChild(el("span", "detail-icon", "\u{1F551}")); // 🕑
                    const durationText = el("span");
                    durationText.appendChild(el("span", "detail-label", "Duration: "));
                    durationText.appendChild(document.createTextNode(` ${trip.duration}`));
                    durationItem.appendChild(durationText);

                    const distanceItem = el("div", "detail-item");
                    distanceItem.appendChild(el("span", "detail-icon", "\u{1F4CD}")); // 📍
                    const distanceText = el("span");
                    distanceText.appendChild(el("span", "detail-label", "Distance: "));
                    distanceText.appendChild(document.createTextNode(` ${trip.distance}km`));
                    distanceItem.appendChild(distanceText);

                    const seasonItem = el("div", "detail-item");
                    seasonItem.appendChild(
                        el("span", `season-badge season-${trip.bestSeason}`, `Best in ${trip.bestSeason}`)
                    );

                    details.append(durationItem, distanceItem, seasonItem);
                    card.appendChild(details);

                    // Description
                    card.appendChild(el("div", "route-description", trip.description));

                    // Highlights
                    const highlights = el("div", "highlights");
                    const highlightsList = el("div", "highlights-list");
                    (trip.highlights || []).forEach(h => {
                        highlightsList.appendChild(el("span", "highlight-tag", h));
                    });
                    highlights.appendChild(highlightsList);
                    card.appendChild(highlights);

                    // Action
                    const actions = el("div", "route-actions");
                    const link = document.createElement("a");
                    link.href = `/trips/${encodeURIComponent(trip.id)}`;
                    link.className = "view-details-btn";
                    link.textContent = "View Details & Book \u2192"; // →
                    actions.appendChild(link);
                    card.appendChild(actions);

                    container.appendChild(card);
                });
            };

            renderTrips();

            regionFilter.addEventListener("change", renderTrips);
            seasonFilter.addEventListener("change", renderTrips);

        } catch (error) {
            console.error("Error loading trips:", error);
            container.replaceChildren();
            container.appendChild(el("p", null, "Error loading trips. Please try again later."));
        }
    });
</script>

<%- include('../partials/footer') %>